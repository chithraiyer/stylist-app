# Copy this file to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables for the live site.

# Your site's address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Console → API Keys
# Leave empty to run in TEST MODE: first looks return a sample answer, no AI cost.
ANTHROPIC_API_KEY=
# Set to true to force test mode even when a key is present.
AI_TEST_MODE=false
# Optional: model used for the AI first look
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe → Developers → API keys (use test keys first)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Product catalog → your $5/month product → Price ID
STRIPE_PRICE_ID=price_...
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Email address(es) of the stylist, comma separated. These accounts get the Studio.
STYLIST_EMAILS=daughter@example.com
